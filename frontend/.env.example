# Backend API URL
# For local development, use:
VITE_API_BASE_URL=http://localhost:8080/api

# For production (Netlify), set this to your deployed backend URL:
# VITE_API_BASE_URL=https://your-backend-api.herokuapp.com/api

# WebSocket URL
# For local development, use:
VITE_WS_URL=http://localhost:8080/ws-game

# For production (Netlify), set this to your deployed backend WebSocket URL:
# VITE_WS_URL=https://your-backend-api.herokuapp.com/ws-game
